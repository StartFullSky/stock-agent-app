<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stockagent.mapper.StockAlertMapper">

    <resultMap id="BaseResultMap" type="com.stockagent.entity.StockAlert">
        <id column="id" property="id"/>
        <result column="stock_code" property="stockCode"/>
        <result column="stock_name" property="stockName"/>
        <result column="alert_type" property="alertType"/>
        <result column="threshold" property="threshold"/>
        <result column="enabled" property="enabled"/>
        <result column="last_triggered_at" property="lastTriggeredAt"/>
        <result column="cooldown_minutes" property="cooldownMinutes"/>
        <result column="message" property="message"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, stock_code, stock_name, alert_type, threshold, enabled,
        last_triggered_at, cooldown_minutes, message, created_at, updated_at
    </sql>

    <!-- 根据股票代码查询所有预警 -->
    <select id="selectByStockCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM stock_alert
        WHERE stock_code = #{stockCode}
        ORDER BY created_at DESC
    </select>

    <!-- 根据股票代码查询已启用的预警 -->
    <select id="selectEnabledByStockCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM stock_alert
        WHERE stock_code = #{stockCode}
          AND enabled = 1
        ORDER BY created_at DESC
    </select>

    <!-- 根据预警类型查询预警 -->
    <select id="selectByAlertType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM stock_alert
        WHERE alert_type = #{alertType}
          AND enabled = 1
        ORDER BY created_at DESC
    </select>

    <!-- 更新预警状态（启用/禁用） -->
    <update id="updateEnabledStatus">
        UPDATE stock_alert
        SET enabled = #{enabled},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 更新上次触发时间 -->
    <update id="updateLastTriggered">
        UPDATE stock_alert
        SET last_triggered_at = NOW(),
            updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
