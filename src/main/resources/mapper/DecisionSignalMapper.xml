<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stockagent.mapper.DecisionSignalMapper">

    <!-- 结果映射 -->
    <resultMap id="DecisionSignalResultMap" type="com.stockagent.entity.DecisionSignal">
        <id property="id" column="id"/>
        <result property="stockCode" column="stock_code"/>
        <result property="stockName" column="stock_name"/>
        <result property="action" column="action"/>
        <result property="confidence" column="confidence"/>
        <result property="score" column="score"/>
        <result property="entryPrice" column="entry_price"/>
        <result property="entryRangeHigh" column="entry_range_high"/>
        <result property="entryRangeLow" column="entry_range_low"/>
        <result property="stopLoss" column="stop_loss"/>
        <result property="targetPrice" column="target_price"/>
        <result property="timeWindow" column="time_window"/>
        <result property="status" column="status"/>
        <result property="sourceAnalysis" column="source_analysis"/>
        <result property="guardrailReason" column="guardrail_reason"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 查询某股票的活跃信号 -->
    <select id="findActiveByStockCode" resultMap="DecisionSignalResultMap">
        SELECT id, stock_code, stock_name, action, confidence, score,
               entry_price, entry_range_high, entry_range_low,
               stop_loss, target_price, time_window, status,
               source_analysis, guardrail_reason, expires_at,
               created_at, updated_at
        FROM decision_signal
        WHERE stock_code = #{stockCode}
          AND status = 'ACTIVE'
        ORDER BY created_at DESC
    </select>

</mapper>
